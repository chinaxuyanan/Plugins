	<key>IDECodeSnippetContents</key>
	<string>// LogKit 耗时测量（性能排查神器）
let result = LogKit.计时(&quot;解析数据&quot;) {        // measure：执行并输出耗时
    try parser.parse(data)
}

let data = try await LogKit.异步计时(&quot;拉取用户信息&quot;) {   // measureAsync
    try await api.fetchUser(id)
}
// 输出示例：[时间] [调试] [通用] 解析数据 耗时 12.3 ms @ 文件:行</string>
	<key>IDECodeSnippetIdentifier</key>
