<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>swreadsize</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// SwiftUIProKit 尺寸监听：观察视图尺寸变化并回调（英文 readSize）
@State private var &lt;#视图尺寸#&gt;: CGSize = .zero

&lt;#内容视图#&gt;
    .读取尺寸 { size in &lt;#视图尺寸#&gt; = size }

Text(&lt;#视图尺寸#&gt;.debugDescription)   // 宽高实时显示</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>EE09D71E-F16E-49F2-8F48-D0B6CCF704B4</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>SwiftUIProKit：readSize 观察视图尺寸变化</string>
	<key>IDECodeSnippetTitle</key>
	<string>读取尺寸 · readSize</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
