		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// 在视图上挂一个确认提示框
.确认提示框(标题: &quot;确认操作？&quot;,
            提示内容: &quot;此操作不可撤销&quot;,
            是否显示: $&lt;#显示确认#&gt;,
            确定文字: &quot;确定&quot;) {
    &lt;#点击确定后执行#&gt;
}</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>05934D76-A290-4304-8CE6-3272736E5767</string>
	<key>IDECodeSnippetLanguage</key>
