<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>swlogtemplate</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// LogKit 格式模板：用占位符接管行格式
let template = LogTemplate("[{级别}] {时间} · {分类}：{消息}")
print(template.render(entry))
// 形如 [警告] 2026-09-11 10:20:30.123 · 网络：下游超时

// 作为自定义格式器（赋给 customFormatter 后本项接管控制台行格式）
LogKit.customFormatter = LogTemplate("{级别}|{消息}|{追踪ID}").formatter

// 中文占位符名同样可用：{时间} {级别} {分类} {消息} {文件} {行} {追踪ID} {字段}
// 写错的占位符原样保留，可用下面两个方法自查
LogTemplate.unknownPlaceholders(in: "{级别} {写错了}")   // ["{写错了}"]
</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>54C6FB35-26DB-496F-B6E1-6A4893062EDF</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>LogKit：用 {级别} {消息} 等占位符接管行格式</string>
	<key>IDECodeSnippetTitle</key>
	<string>格式模板 · LogTemplate</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
