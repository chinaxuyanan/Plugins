<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>swsysinfobatterypower</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// SystemInfoKit 电池温度与电源明细（仅 macOS）
print(SystemInfoKit.powerSourceName)          // 交流电源 / 电池 / 不支持（台式机）
print(SystemInfoKit.batteryTemperatureText)   // 30.3 ℃ / 不支持

if let 适配器 = SystemInfoKit.powerAdapter {
    print(适配器.text)          // 适配器 96W · 20.0V · 4.80A
    print(适配器.voltageText)   // 20.0V（USB-C PD 的协商值，会随电量动态调整）
} else {
    print("未接电源 / 台式机无内置电池")
}

// 中文别名：SystemInfoKit.电池温度 / 电池温度文本 / 供电来源 / 电源适配器 / 电源适配器文本
</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>B1D2C276-E097-46D9-BF67-AA2F8DFB8311</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>SystemInfoKit：电池温度与电源适配器明细（仅 macOS）</string>
	<key>IDECodeSnippetTitle</key>
	<string>电池温度与电源明细 · batteryTemperature / powerAdapter</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
