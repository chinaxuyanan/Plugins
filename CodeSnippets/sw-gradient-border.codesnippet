<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>swgradientborder</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// SwiftUIProKit 渐变描边：给视图镶一圈渐变边框（英文 gradientBorder）
Text("会员专享")
    .padding(16)
    .背景颜色(.white)
    .渐变描边([.purple, .blue], 线宽: 2, 圆角: 12)   // 可用 起点/终点 指定渐变方向
</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>B8B3EC79-877D-4903-BEC9-9D1528E0A57C</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>SwiftUIProKit：gradientBorder 给视图叠加渐变圆角描边</string>
	<key>IDECodeSnippetTitle</key>
	<string>渐变描边 · gradientBorder</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
