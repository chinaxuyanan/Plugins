<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>swsysinfomempressmonitor</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// 内存压力监听器（仅 macOS）
let &lt;#监听#&gt; = MemoryPressureMonitor()
&lt;#监听#&gt;.压力变化回调 = { event in
    if event.contains(.critical) { &lt;#释放缓存#&gt; }
}
&lt;#监听#&gt;.开始监听()
// 用完后：&lt;#监听#&gt;.停止监听()</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>C4DC7BF2-E53C-4FEA-9F7F-58F1D2DD3A59</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>SystemInfoKit：MemoryPressureMonitor 实时回调（仅 macOS）</string>
	<key>IDECodeSnippetTitle</key>
	<string>SystemInfoKit · 内存压力监听</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
