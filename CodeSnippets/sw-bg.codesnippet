	<key>IDECodeSnippetContents</key>
	<string>// 背景、圆角与阴影（SwiftUIProKit 中文别名）
.背景颜色(.blue)                         // 背景颜色
.渐变背景([.blue, .purple], 起点: .topLeading, 终点: .bottomTrailing)  // 线性渐变
.圆角裁剪(16)                            // 圆角裁剪
.圆角描边(颜色: .gray, 宽度: 1, 圆角半径: 8)  // 圆角描边
.轻阴影() / .中阴影() / .强阴影()          // 三级阴影（任选）</string>
	<key>IDECodeSnippetIdentifier</key>
