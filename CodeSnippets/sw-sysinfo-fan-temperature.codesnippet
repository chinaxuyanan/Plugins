<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>swsysinfofan</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// SystemInfoKit 风扇转速与整机温度（读 SMC，仅 macOS）
import SystemInfoKit

// 风扇转速：通过 SMC 的 FNum 问出数量，再逐个读 F0Ac / F1Ac…
for 风扇 in SystemInfoKit.fanSpeeds {
    print(风扇.text)        // 风扇 0：2400 RPM
    print(风扇.index, 风扇.rpm)
}
print(SystemInfoKit.fanSpeedsText)   // 无风扇或读取不到时返回「无风扇或读取不到」

// 整机温度：依次尝试 TC0P / TG0P / TB0T / Apple Silicon 的 Tp0x 等常见传感器，取最高读数
print(SystemInfoKit.machineTemperature)       // Double?，读不到为 nil
print(SystemInfoKit.machineTemperatureText)   // 46.5 ℃ / 不支持

// 无风扇机型（MacBook Air、部分 Apple Silicon Mac）读不到风扇是正常的
// 两个属性都要遍历 SMC，开销较大，建议按需调用
// 中文别名：风扇转速列表 / 风扇转速文本 / 整机温度 / 整机温度文本
//          风扇转速（等同 FanSpeed，结构体带 序号 / 转速）
</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>BF2255CB-2394-490C-AE4F-431F24F7C150</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>SystemInfoKit：读 SMC 取风扇转速与整机温度（仅 macOS）</string>
	<key>IDECodeSnippetTitle</key>
	<string>风扇转速与整机温度 · fanSpeeds / machineTemperature</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
