<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>swlogexportjson</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// LogKit JSON 导出：与 CSV 不同，这里不加 UTF-8 BOM（BOM 会让严格的 JSON 解析器报错）
var 收集: [LogEntry] = []
let 去向 = LogKit.添加输出 { 收集.append($0) }
LogKit.信息("下单成功", 分类: "订单", fields: ["订单号": "A100", "金额": 99])

let 文本 = LogKit.JSON字符串(条目: 收集)                 // 默认缩进美化，空数组返回 []
let 紧凑 = LogKit.JSON字符串(条目: 收集, 美化: false)     // 压成一行
let 文件 = try LogKit.导出JSON(收集, 文件名: "订单日志")   // 写入临时目录，返回 URL 交给分享面板
LogKit.移除输出(去向)
</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>1F3ED1A9-4669-4099-AA96-ADE3CFFF28FD</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>LogKit：把日志条目导出成 JSON 文本或文件，键排序、可缩进；不加 UTF-8 BOM（否则严格 JSON 解析器报错）</string>
	<key>IDECodeSnippetTitle</key>
	<string>JSON 导出 · exportJSON</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
