	<key>IDECodeSnippetContents</key>
	<string>// 动画与过渡（SwiftUIProKit 中文别名）
.动画(曲线: .easeInOut, 值: &lt;#状态值#&gt;)   // 状态变化时动画
.淡入淡出过渡()                          // opacity
.滑动过渡(方向: .trailing)               // 从边缘滑入
.缩放过渡(比例: 0.9)                     // 缩放过渡
.淡入缩放过渡(比例: 0.9)                 // 淡入 + 缩放</string>
