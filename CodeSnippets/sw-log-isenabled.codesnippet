<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>swlogisenabled</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// LogKit 输出预判：提前判断这条日志是否会被输出，避免无谓的消息构造（英文 isEnabled）
if LogKit.是否输出(级别: .debug, 分类: "网络") {
    LogKit.调试("耗时 \(expensiveDescription())", 分类: "网络")   // 只有会输出时才构造消息
}
</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>9F8E03CD-6674-4A77-8467-67D80C0E4E5E</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>LogKit：isEnabled 提前判断日志是否会被输出，避免无谓的消息构造</string>
	<key>IDECodeSnippetTitle</key>
	<string>输出预判 · isEnabled</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
