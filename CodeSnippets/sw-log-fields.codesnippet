<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>swlogfields</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>All</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>// LogKit 结构化字段（配合 JSON 输出）
LogKit.输出格式 = .JSON        // outputFormat = .json
LogKit.信息(&quot;请求完成&quot;, 字段: [&quot;接口&quot;: &quot;/api/user&quot;, &quot;状态码&quot;: 200])
// 或英文：LogKit.info(&quot;请求完成&quot;, fields: [&quot;接口&quot;: &quot;/api/user&quot;, &quot;状态码&quot;: 200])
// JSON 输出会把字段收进 &quot;fields&quot; 子对象</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>024E8D23-2442-4EAE-B08A-7FE6FEB24FFB</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>LogKit：fields 结构化字段（配合 JSON 输出成 fields 子对象）</string>
	<key>IDECodeSnippetTitle</key>
	<string>LogKit · 结构化字段</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
